# backend/.env.example — LOCAL DEVELOPMENT ONLY
#
#   cp backend/.env.example backend/.env      # backend/.env is git-ignored
#
# Production does not use this file: the API container gets its settings from
# deploy/docker-compose.api.yml and its secrets from Docker secret files
# (see specs/004-backend-container-deploy/implementation.md).

# ── Runtime mode ────────────────────────────────────────────────────────────
# APP_ENV: production (default when unset; strictest rules) | development
#   development allows http://localhost CORS origins and prints undeliverable
#   emails (verification/reset codes, invite links) to the console, clearly
#   labelled DEVELOPMENT ONLY. Never use development on a shared or public server.
APP_ENV=development

# APP_MODE: all (API + Discord bot; default) | api (API only: no Discord bot
#   processes, MongoDB Knowledge Base routes return 503 pending the
#   PostgreSQL/pgvector migration)
APP_MODE=api

# ── CORS (required; no default, no wildcard) ────────────────────────────────
# Comma-separated exact origins. http://localhost / http://127.0.0.1 are only
# accepted with APP_ENV=development.
CORS_ORIGINS=http://localhost:3000

# ── MongoDB (required) ──────────────────────────────────────────────────────
# Use a separate development database; never point this at production.
MONGO_URL=mongodb://localhost:27017/bitbotpro_dev
DB_NAME=bitbotpro_dev

# ── Secrets (required) ──────────────────────────────────────────────────────
# JWT signing secret: openssl rand -hex 32   (changing it invalidates sessions)
JWT_SECRET=replace-with-openssl-rand-hex-32
# Fernet key for stored integration secrets:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# ── Administrator ───────────────────────────────────────────────────────────
# The API never creates an administrator on startup. Create the first
# superadmin once, explicitly (the password is read from a file, never an argument):
#   python manage.py bootstrap-superadmin --email you@example.com --password-file /path/to/file          # dry run
#   python manage.py bootstrap-superadmin --email you@example.com --password-file /path/to/file --confirm
# Legacy data migrations are also explicit only:
#   python manage.py legacy-migrations            # report only

# ── Optional integrations ───────────────────────────────────────────────────
# Without RESEND_API_KEY: production returns 503 for email flows; development
# uses the labelled console fallback.
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com
# Public base URL used to build webhook/invite links.
REACT_APP_BACKEND_URL=http://localhost:8000
# Emergent-only provider/storage (unused off Emergent):
#CLAUDE_API_KEY=
#EMERGENT_LLM_KEY=
