# Static admin app for beta.bitbotpro.io, served inside bitbotpro-beta-web (TLS terminates at the VPS Caddy).
{
	admin off
	auto_https off
}
:8080 {
	root * /srv
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@hashed path /static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell not path /static/*
	header @shell Cache-Control "no-store"
	try_files {path} /index.html
	file_server
}
