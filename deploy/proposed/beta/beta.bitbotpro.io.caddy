# PROPOSED (Spec 012 Phase 6D) — NOT INSTALLED. Two NEW site blocks for the private beta, installed as ONE
# extra `import` line by deploy/proposed/beta/vps-caddy-beta-site.sh. The existing Gridscan and
# api.bitbotpro.io sites are not changed. Upstreams are on the BBP1 WireGuard address (wg-bbp 10.50.0.20).
# - DNS: beta-api.bitbotpro.io and beta.bitbotpro.io A <VPS IP> (DNS-only), so Caddy obtains certificates.
# - CF-Connecting-IP is OVERWRITTEN with the real client address; the API trusts it only from 10.50.0.1.
# - No `log` directive: paths carry webhook secrets and share-link tokens.

beta-api.bitbotpro.io {
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy 10.50.0.20:8001 {
			header_up Host {host}
			header_up CF-Connecting-IP {remote_host}
			header_up -X-Real-IP
			flush_interval -1
			transport http {
				dial_timeout 5s
				keepalive 90s
			}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		respond 404
	}

	header {
		-Server
	}
}

beta.bitbotpro.io {
	reverse_proxy 10.50.0.20:8002 {
		transport http {
			dial_timeout 5s
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
