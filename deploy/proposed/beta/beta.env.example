# PROPOSED (Spec 012 Phase 6D) — copy to deploy/proposed/beta/beta.env (git-ignored location recommended:
# outside the repository) and fill in. Contains NO secrets: secrets are files in $BITBOTPRO_BETA_SECRETS_DIR.
BITBOTPRO_BETA_SECRETS_DIR=/home/<operator>/.bitbotpro/beta-secrets      # 0700 dir; files 0640, group 10001
BETA_IMAGE_TAG=spec012-beta1-4219354d1469
BETA_FROM_EMAIL=beta@bitbotpro.io                                       # a sender on the Resend-verified domain
BETA_FRONTEND_BUILD=/home/<operator>/projects/discord-pro/frontend/build-beta
#
# Secret files (never in this file, never in a terminal log):
#   beta_mongo_url         mongodb://bitbotpro_v12_app:<pw>@bitbotpro-mongo:27017/bitbotpro_v12?authSource=bitbotpro_v12&maxPoolSize=20
#   beta_jwt_secret        48+ random characters (new; not the production value)
#   beta_encryption_keys   k1=<new Fernet key>            (offline copy kept with the backups)
#   beta_resend_api_key    a Resend key restricted to "sending access" for the bitbotpro.io domain (new; not production's)
#   beta_mongo_app_password  (only for creating the MongoDB user; ≥ 32 characters)
