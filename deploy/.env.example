# deploy/.env.example — copy to deploy/.env (git-ignored). Contains NO secrets.
# Points at a directory (mode 0700, outside the repo) holding one file per secret.
BITBOTPRO_SECRETS_DIR=/home/CHANGE_ME/.bitbotpro/secrets

# API image tag used by deploy/docker-compose.api.yml (e.g. the git short SHA).
BITBOTPRO_API_TAG=CHANGE_ME

# Optional overrides (defaults shown)
#MONGO_ROOT_USER=root
#MONGO_APP_DB=bitbotpro
#MONGO_APP_USER=bitbotpro_app
#MONGO_WT_CACHE_GB=2
#PG_KB_DB=bitbotpro_kb
#PG_MIGRATOR_USER=bitbotpro_migrator
#PG_APP_USER=bitbotpro_app
#PG_SHARED_BUFFERS=1GB
#PG_MAINTENANCE_WORK_MEM=512MB

# Cloudflare Tunnel ID (UUID from `cloudflared tunnel create`; not a secret). Spec 008 Stage 10.
CLOUDFLARE_TUNNEL_ID=
